[TEMPLATE]
# ============================================================
# AI provider: DeepSeek, UnoRouter, OpenRouter & OpenAI-compatible APIs (server-side only)
# ------------------------------------------------------------
# Copy to .env and configure a provider that supports tool/function calling.
# Never use VITE_* variables for credentials; they are exposed in browser bundles.
# ============================================================

# Option 1: UnoRouter (Multi-model AI Gateway with 238+ models and 117+ free tier)
# Platform: https://unorouter.com
# Base URL: https://api.unorouter.com/v1
# Key format: sk-xxxxxxxx
UNOROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: DeepSeek Official API (Recommended for ultra-fast, high-context retrieval)
# Platform: https://platform.deepseek.com
# Base URL: https://api.deepseek.com/v1 (or https://api.deepseek.com)
# Models: deepseek-v4-flash, deepseek-v4-pro
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 3: Preferred Gateway selection (optional: 'unorouter' | 'openrouter')
# MODEL_GATEWAY=unorouter

# Option 4: Generic OpenAI-compatible API base URL
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your_server_side_api_key

# Provider's model ID (optional; defaults to deepseek/deepseek-v4-flash for UnoRouter, deepseek-v4-flash for DeepSeek, or gpt-4o-mini)
# The Agent model must support tool/function calling.
# AI_MODEL=deepseek/deepseek-v4-flash

# Fail closed for every AI request when set to true
# AI_API_DISABLED=false

# Legacy migration aliases (prefer UNOROUTER_API_KEY / AI_API_* for new configurations)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENROUTER_KEY=legacy_alias
# OPENROUTER_DISABLED=false

# ============================================================
# Search engine (optional)
# ============================================================

# Custom SearXNG instance (optional; otherwise the built-in cluster is used)
# SEARXNG_URL=https://your-searxng-instance.example.com

# Multiple instances, comma-separated
# SEARXNG_URLS=
