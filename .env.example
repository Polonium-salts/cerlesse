[TEMPLATE]
# ============================================================
# AI provider: DeepSeek & OpenAI-compatible Chat Completions API (server-side only)
# ------------------------------------------------------------
# Copy to .env and configure a provider that supports tool/function calling.
# Never use VITE_* variables for credentials; they are exposed in browser bundles.
# ============================================================

# DeepSeek Official API (Recommended for ultra-fast, high-context retrieval)
# Platform: https://platform.deepseek.com
# Base URL: https://api.deepseek.com/v1 (or https://api.deepseek.com)
# Models: deepseek-v4-flash, deepseek-v4-pro
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI-compatible API base URL (optional; defaults to https://api.deepseek.com if DEEPSEEK_API_KEY is present, or https://api.openai.com)
# Can be the origin, /v1 base, or /v1/chat/completions URL.
# AI_API_BASE_URL=https://api.openai.com/v1

# Generic server-side provider secret (required if not using DEEPSEEK_API_KEY)
# AI_API_KEY=your_server_side_api_key

# Provider's model ID (optional; defaults to deepseek-v4-flash when using DeepSeek, or gpt-4o-mini)
# The Agent model must support tool/function calling.
# AI_MODEL=deepseek-v4-flash

# Fail closed for every AI request when set to true
# AI_API_DISABLED=false

# Legacy migration aliases (prefer AI_API_* for new configurations)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENROUTER_KEY=legacy_alias
# OPENROUTER_DISABLED=false

# ============================================================
# Search engine (optional)
# ============================================================

# Custom SearXNG instance (optional; otherwise the built-in cluster is used)
# SEARXNG_URL=https://your-searxng-instance.example.com

# Multiple instances, comma-separated
# SEARXNG_URLS=
