{
  "$schema": "./widget-manifest.schema.json",
  "id": "company_info",
  "name": "公司信息",
  "version": "1.0.0",
  "description": "智能呈现企业与公司全景信息卡片，包含企业全称、总部园区实况照片、业务概览详述及维基百科权威溯源直达",
  "presence": "conditional",
  "category": "synthesis",
