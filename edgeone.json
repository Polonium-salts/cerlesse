{
  "name": "cerlesse",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "directory": "functions"
  },
  "routes": [
    {
      "src": "/widgets/(.*)",
      "headers": {
        "cache-control": "public, max-age=3600, s-maxage=86400"
      }
    }
  ],
  "env": {
    "OPENROUTER_KEY": "your_openrouter_api_key_here",
    "SEARXNG_URL": "optional_searxng_instance_url"
  }
}
