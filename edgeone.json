{
  "name": "cerlesse",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "directory": "functions"
  },
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "env": {
    "OPENROUTER_KEY": "your_openrouter_api_key_here",
    "SEARXNG_URL": "optional_searxng_instance_url"
  }
}
